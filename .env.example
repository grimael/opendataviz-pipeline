# Copy this file to .env and fill in the keys you have. .env is gitignored —
# never commit real keys.

# Which provider the conversational agent (/agent/chat) uses. Leave unset to
# auto-pick whichever key below is present (groq checked first).
LLM_PROVIDER=groq

# https://console.groq.com/keys
GROQ_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default model for the selected provider
# (groq default: openai/gpt-oss-120b, gemini default: gemini-3.6-flash)
LLM_MODEL=

# Comma-separated list of origins allowed to call the API (CORS). Defaults to
# the local dashboard dev server if unset. Set this to your deployed
# dashboard's real origin(s) in production — never "*", since /agent/chat and
# /export/* do real work (paid LLM calls, file generation) per request.
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
